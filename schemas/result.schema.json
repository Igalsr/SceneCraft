{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/result.schema.json",
  "title": "SceneCraft Worker Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "status", "artifacts", "metrics", "warnings", "error"],
  "properties": {
    "schema_version": {"const": 2},
    "job_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "metrics": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {"type": ["string", "null"]}
  }
}
