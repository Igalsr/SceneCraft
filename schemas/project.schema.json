{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/project.schema.json",
  "title": "SceneCraft Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "workflow", "units", "acceptance"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "workflow": {"enum": ["hero-view", "multi-view", "metric"]},
    "asset_type": {"enum": ["building", "object", "positive-master"]},
    "units": {"const": "meters"},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 30},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette_iou", "edge_f1", "perceptual_similarity"],
      "properties": {
        "silhouette_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "edge_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "perceptual_similarity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
