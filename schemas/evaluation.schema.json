{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/evaluation.schema.json",
  "title": "SceneCraft Fidelity Evaluation",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "iteration", "views", "hard_checks", "aggregate_score", "accepted", "repair_priorities", "metrics_passed", "visual_review"],
  "properties": {
    "schema_version": {"const": 3},
    "metrics_passed": {"type": "boolean"},
    "visual_review": {"oneOf": [{"type": "null"}, {"$ref": "visual-review.schema.json"}]},
    "iteration": {"type": "integer", "minimum": 0},
    "views": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference_id", "view", "reference_path", "render_path", "metrics", "thresholds", "passed"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "view": {"type": "string", "minLength": 1},
          "reference_path": {"type": "string", "minLength": 1},
          "render_path": {"type": "string", "minLength": 1},
          "metrics": {"$ref": "#/$defs/scores"},
          "thresholds": {"$ref": "#/$defs/scores"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "hard_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "passed", "detail"],
        "properties": {"name": {"type": "string"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}
      }
    },
    "aggregate_score": {"type": "number", "minimum": 0, "maximum": 1},
    "accepted": {"type": "boolean"},
    "repair_priorities": {"type": "array", "items": {"enum": ["silhouette_iou", "edge_f1", "perceptual_similarity"]}}
  },
  "$defs": {
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["silhouette_iou", "edge_f1", "perceptual_similarity"],
      "properties": {
        "silhouette_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "edge_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "perceptual_similarity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
