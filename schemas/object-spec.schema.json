{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/object-spec.schema.json",
  "title": "SceneCraft object or positive master specification",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "units", "camera", "objects", "required_features", "uncertainties"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"enum": ["object", "positive-master"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 160}, "units": {"const": "meters"},
    "camera": {"$ref": "building-spec.schema.json#/properties/camera"},
    "required_features": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "uncertainties": {"$ref": "building-spec.schema.json#/properties/uncertainties"},
    "manufacturing": {
      "type": "object", "additionalProperties": false,
      "required": ["target_dimensions_m", "dimension_tolerance_m", "minimum_feature_m", "scale_source", "release_strategy"],
      "properties": {
        "target_dimensions_m": {"$ref": "#/$defs/dimensions"},
        "dimension_tolerance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01},
        "minimum_feature_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
        "scale_source": {"type": "string", "minLength": 1, "maxLength": 2000},
        "release_strategy": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "primitive", "operation", "center", "dimensions", "rotation_deg", "color"],
        "properties": {
          "id": {"$ref": "building-spec.schema.json#/$defs/id"},
          "primitive": {"enum": ["box", "sphere", "cylinder", "cone", "torus", "mesh"]},
          "operation": {"enum": ["union", "difference"]},
          "center": {"$ref": "building-spec.schema.json#/$defs/vector3"},
          "dimensions": {"$ref": "#/$defs/dimensions"},
          "rotation_deg": {"$ref": "building-spec.schema.json#/$defs/vector3"},
          "color": {"$ref": "building-spec.schema.json#/$defs/color3"},
          "vertices": {"type": "array", "minItems": 4, "maxItems": 50000, "items": {"$ref": "building-spec.schema.json#/$defs/vector3"}},
          "faces": {"type": "array", "minItems": 4, "maxItems": 100000, "items": {"type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}
        },
        "allOf": [{"if": {"properties": {"primitive": {"const": "mesh"}}}, "then": {"required": ["vertices", "faces"]}, "else": {"not": {"anyOf": [{"required": ["vertices"]}, {"required": ["faces"]}]}}}]
      }
    }
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "positive-master"}}}, "then": {"required": ["manufacturing"]}}],
  "$defs": {"dimensions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.00001, "maximum": 100}}}
}
