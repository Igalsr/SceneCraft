{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/learning-report.schema.json",
  "title": "SceneCraft Run Learning Report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "captured_at", "completed", "no_lessons_reason", "lessons"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "completed": {"type": "boolean"},
    "no_lessons_reason": {"type": ["string", "null"]},
    "lessons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lesson_id", "memory_scope", "status", "action_key", "evidence"],
        "properties": {
          "lesson_id": {"type": "string"},
          "memory_scope": {"enum": ["project", "workflow"]},
          "status": {"enum": ["candidate", "validated", "deprecated"]},
          "action_key": {"type": "string"},
          "evidence": {"type": "object"}
        }
      }
    }
  }
}
