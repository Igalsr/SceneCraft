{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/building-spec.schema.json",
  "title": "SceneCraft Building Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "units", "envelope", "floors", "wall_thickness", "camera", "materials", "uncertainties"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "units": {"const": "meters"},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "depth": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "floors": {"type": "integer", "minimum": 1, "maximum": 200},
    "wall_thickness": {"type": "number", "exclusiveMinimum": 0},
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "target", "lens_mm"],
      "properties": {
        "position": {"$ref": "#/$defs/vector3"},
        "target": {"$ref": "#/$defs/vector3"},
        "lens_mm": {"type": "number", "minimum": 10, "maximum": 300}
      }
    },
    "materials": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_rgb", "roof_rgb", "glass_rgb"],
      "properties": {
        "wall_rgb": {"$ref": "#/$defs/color3"},
        "roof_rgb": {"$ref": "#/$defs/color3"},
        "glass_rgb": {"$ref": "#/$defs/color3"},
        "accent_rgb": {"$ref": "#/$defs/color3"}
      }
    },
    "volumes": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "center", "dimensions", "material"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "center": {"$ref": "#/$defs/vector3"},
          "dimensions": {"$ref": "#/$defs/positiveVector3"},
          "material": {"$ref": "#/$defs/material"},
          "rotation_deg": {"type": "number"}
        }
      }
    },
    "openings": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "facade", "center", "width", "height"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["window", "door"]},
          "facade": {"enum": ["front", "back", "left", "right"]},
          "center": {"$ref": "#/$defs/vector2"},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "frame_width": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "elements": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "semantic", "center", "dimensions", "material"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "semantic": {"enum": ["balcony", "canopy", "column", "screen", "trim"]},
          "center": {"$ref": "#/$defs/vector3"},
          "dimensions": {"$ref": "#/$defs/positiveVector3"},
          "material": {"$ref": "#/$defs/material"},
          "rotation_deg": {"type": "number"}
        }
      }
    },
    "roof": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["flat", "gable"]},
        "overhang": {"type": "number", "minimum": 0},
        "pitch_degrees": {"type": "number", "minimum": 1, "maximum": 75}
      }
    },
    "uncertainties": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "reason", "confidence"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
    "material": {"enum": ["wall", "roof", "glass", "accent"]},
    "vector2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "vector3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "positiveVector3": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
    "color3": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3}
  }
}
