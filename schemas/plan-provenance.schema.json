{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/plan-provenance.schema.json",
  "title": "SceneCraft Plan Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source",
    "openai_api_used",
    "lessons_applied",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["astra-agent", "manual"]},
    "openai_api_used": {"const": false},
    "lessons_applied": {
      "type": "array",
      "items": {"type": "string", "pattern": "^lesson-[a-f0-9]{12}$"},
      "uniqueItems": true
    },
    "submitted_at": {"type": "string", "format": "date-time"}
  }
}
