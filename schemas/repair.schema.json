{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/repair.schema.json",
  "title": "SceneCraft Repair Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "based_on_iteration", "changes", "building_spec"],
  "properties": {
    "schema_version": {"const": 2},
    "based_on_iteration": {"type": "integer", "minimum": 0},
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "reason"],
        "properties": {
          "target": {"type": "string", "minLength": 1, "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "building_spec": {"$ref": "scene-spec.schema.json"}
  }
}
