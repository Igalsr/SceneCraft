{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenecraft.local/schemas/learning-memory.schema.json",
  "title": "SceneCraft Learning Memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lessons"],
  "properties": {
    "schema_version": {"const": 2},
    "lessons": {
      "type": "array",
      "items": {"$ref": "#/$defs/lesson"}
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "action_key",
        "status",
        "stage",
        "workflow_scope",
        "trigger",
        "learning",
        "recommended_action",
        "confidence",
        "evidence",
        "application_count",
        "last_applied_run_id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^lesson-[a-f0-9]{12}$"},
        "action_key": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {"enum": ["candidate", "validated", "deprecated"]},
        "stage": {"type": "string", "minLength": 1},
        "workflow_scope": {
          "type": "array",
          "items": {"enum": ["hero-view", "multi-view", "metric"]},
          "uniqueItems": true
        },
        "trigger": {"type": "string", "minLength": 1},
        "learning": {"type": "string", "minLength": 1},
        "recommended_action": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "before_score",
            "after_score",
            "delta",
            "regressed_views",
            "artifact_paths"
          ],
          "properties": {
            "kind": {"enum": ["measured", "observation"]},
            "run_id": {"type": "string", "minLength": 1},
            "before_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "after_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "delta": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
            "regressed_views": {"type": "array", "items": {"type": "string"}},
            "artifact_paths": {"type": "array", "items": {"type": "string"}}
          }
        },
        "application_count": {"type": "integer", "minimum": 0},
        "last_applied_run_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
